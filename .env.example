# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored: real credentials never go into the repository.

# Neon POOLED connection string (the host contains "-pooler"). The app uses this.
# Neon console > your project > Connect > "Connection pooling" ON.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optional: the DIRECT (unpooled) connection string, same host without
# "-pooler". `npm run db:migrate` prefers it when it is set.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# The site's public address, with no trailing slash. Links in emails and
# calendar files are built from this, never from the request's Host header.
APP_URL="http://localhost:3000"

# Optional: a Resend API key (https://resend.com). Without it, emails are
# printed to the server console instead, links and calendar files included.
RESEND_API_KEY=""

# The sender address. With Resend it must be on a domain you verified there;
# "onboarding@resend.dev" works for testing (it only delivers to your own address).
EMAIL_FROM="Ìpàdé <onboarding@resend.dev>"

# A long random string. Vercel Cron sends it as "Authorization: Bearer <secret>"
# to /api/cron/reminders; any request without it gets 401.
# Make one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Passwords for the demo accounts that `npm run db:seed` creates
# (admin@example.com, stylist@example.com and client@example.com).
# 8 to 128 characters; pick your own, they are never stored in the code.
SEED_ADMIN_PASSWORD=""
SEED_STYLIST_PASSWORD=""
SEED_CLIENT_PASSWORD=""
